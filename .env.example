# Required
DATABASE_URL=postgres://collab:collab-dev-password@localhost:5432/collab?sslmode=disable
AUTH_ISSUER=http://localhost:8081
AUTH_CLIENT_SECRET=dev-only-t10-collab-service-secret-change-me

# Optional
# AUTH_URL=                     where this service reaches auth, if not AUTH_ISSUER
# AUTH_CLIENT_ID=t10-collab
# COLLAB_LISTEN_ADDR=:8082
# OTEL_EXPORTER_OTLP_ENDPOINT=  an OTLP/gRPC host:port. Unset turns telemetry off
